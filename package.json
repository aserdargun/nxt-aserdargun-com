{
  "name": "nxt-aserdargun-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "node scripts/run-e2e.mjs",
    "project:test": "node --test tools/project-contract.test.mjs",
    "api:build": "node scripts/build-api.mjs",
    "web:build": "pnpm --filter @nxt/web build",
    "artifact:verify": "node scripts/verify-artifacts.mjs",
    "dev:codex": "node scripts/local-dev.mjs",
    "stop:codex": "node scripts/stop-local.mjs",
    "validate:codex": "pnpm lint && pnpm typecheck && pnpm api:build && pnpm web:build && pnpm artifact:verify && pnpm test && pnpm project:test && node --test --test-concurrency=1 tools/static-security.test.mjs tools/artifact-contract.test.mjs tools/local-fixtures.test.mjs tools/e2e-runner.integration.test.mjs tools/local-lifecycle.integration.test.mjs && git diff --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@azure/static-web-apps-cli": "2.0.10",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  }
}
